meta {
  name: createDraft
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: none
  auth: none
}

headers {
  x-bot-internal-secret: {{botInternalSecret}}
  x-telegram-user-id: {{staffTelegramUserId}}
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    const payload = res.getBody();
    const data = payload.data ?? payload;
    const value = (data.order ?? data).id;
    if (value) bru.setVar("orderId", value);
  }
}

docs {
  Internal Telegram API. Requires an ACTIVE employee with the corresponding role and matching BOT_INTERNAL_SECRET.
}
