meta {
  name: adminLogin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/admin/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    const data = res.getBody().data;
    if (data?.accessToken) bru.setVar("accessToken", data.accessToken);
    if (data?.refreshToken) bru.setVar("refreshToken", data.refreshToken);
    if (data?.user?.id) bru.setVar("userId", data.user.id);
  }
}

docs {
  Log in an owner account

  Source: backend/docs/openapi.yaml

}
