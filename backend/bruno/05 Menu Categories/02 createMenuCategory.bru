meta {
  name: createMenuCategory
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/menu-categories
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Bruno Test Category",
    "displayOrder": 0,
    "isActive": true
  }
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    const payload = res.getBody();
    const data = payload.data ?? payload;
    const value = data.id;
    if (value) bru.setVar("categoryId", value);
  }
}

docs {
  Create a menu category

  Source: backend/docs/openapi.yaml

}
