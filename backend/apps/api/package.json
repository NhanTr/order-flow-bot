{
  "name": "@order-flow/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../../../.env.local src/index.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "check:auth": "tsc -p tsconfig.auth.json",
    "start": "node dist/src/server.js",
    "test:auth": "vitest run --config vitest.config.mts",
    "test": "vitest run --config vitest.config.mts",
    "test:auth:integration": "vitest run --config vitest.integration.config.mts",
    "test:security:integration": "vitest run --config vitest.security-integration.config.mts",
    "test:node": "node --import tsx --test test/auth-session.store.test.ts test/auth.routes.test.ts test/auth.service.test.ts test/database.test.ts test/employees.routes.test.ts test/menu-categories.routes.test.ts test/menu-items.routes.test.ts test/shared-middleware.test.ts test/telegram-init-data.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "5.2.1",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "jose": "^6.2.8",
    "pg": "^8.22.0",
    "redis": "^6.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/http-errors": "^2.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^6.0.3",
    "jest": "^30.4.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.7.2",
    "vitest": "^4.1.11"
  }
}
